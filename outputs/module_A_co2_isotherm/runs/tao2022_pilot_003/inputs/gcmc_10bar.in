units real
atom_style full
boundary p p p
read_data outputs/module_A_co2_isotherm/runs/tao2022_pilot_003/data/IRMOF-1.data extra/bond/per/atom 2 extra/special/per/atom 2
molecule co2 outputs/module_A_co2_isotherm/runs/tao2022_pilot_003/molecules/co2.template
include outputs/module_A_co2_isotherm/runs/tao2022_pilot_003/forcefield/forcefield.in
group framework type 1 2 3 4
group adsorbate type 5 6
# pressure_bar metadata: 10
fix gcmc_co2 adsorbate gcmc 1 10 10 0 12345 298.15 0 1 mol co2 group adsorbate full_energy pressure 9.86923 fugacity_coeff 0.9461 
thermo 100
thermo_style custom step atoms temp pe etotal press f_gcmc_co2[3] f_gcmc_co2[4] f_gcmc_co2[5] f_gcmc_co2[6]
dump traj all custom 1000 outputs/module_A_co2_isotherm/runs/tao2022_pilot_003/dumps/gcmc_10bar.lammpstrj id mol type q x y z
dump_modify traj sort id
run 1000000
