{
  "material": {
    "name": "MOF-5",
    "cif_source": "auto",
    "charge_scheme": "DDEC",
    "source": "crafted"
  },
  "adsorbates": {
    "components": [
      "N2"
    ],
    "mixture": null
  },
  "conditions": {
    "temperature_K": 298.15,
    "pressures_bar": [
      0.1, 0.5, 1, 2, 5, 10, 20, 35
    ]
  },
  "benchmark": {
    "task": "auto",
    "metrics": [
      "isotherm",
      "error_to_reference",
      "runtime",
      "validity_range"
    ],
    "reference": {
      "source": "auto",
      "preferred_sources": [
        "crafted",
        "nist_isodb"
      ],
      "temperature_tolerance_K": 2.0,
      "max_nist_candidates": 5,
      "deduplicate_nist_by_doi": true,
      "exclude_nist_outliers": true,
      "nist_max_loading_mol_per_kg": 60.0,
      "nist_max_reference_ratio": 3.0,
      "allowed_reference_basis": [
        "absolute",
        "simulation_reference",
        "excess"
      ],
      "allow_unknown_reference_basis": true,
      "allow_excess_reference_basis": true,
      "require_known_nist_article_source": false,
      "material": "MOF-5",
      "adsorbate": "N2"
    },
    "paper": {
      "citation": "Tao, Zhang, Xu, Sustainable Materials and Technologies 32 (2022) e00383",
     "target_protocol": "Technical pure N2 GCMC smoke test for MOF-5 at 298 K and 5 bar using the rigid conventional 1x1x1 cell."
    }
  },
  "simulation": {
    "engine": "LAMMPS",
    "method": "GCMC",
    "forcefield": {
      "framework": "UFF",
      "adsorbate": "auto",
      "cross_interactions": "auto"
    },
    "framework": "rigid",
    "cell_representation": "conventional",
    "minimum_image_policy": "error",
    "units": "real",
    "atom_style": "full",
    "pair_style": "lj/cut/coul/long",
    "cutoff_A": 12.8,
    "kspace_style": "pppm",
    "kspace_accuracy": 1e-4,
    "unit_cells": [
      1,
      1,
      1
    ],
    "seeds": [
      12345
    ],
    "cycles": 500000,
    "initialization_cycles": 500000
  },
  "convergence": {
    "minimum_replicates": 3,
    "relative_ci95_target": 0.05
  },
  "evaluation": {
    "simulation_basis": "absolute",
    "report_excess": true,
    "pore_volume_cm3_g": "auto",
    "pore_volume_source": null,
    "pore_volume_method": null,
    "gas_density_backend": "HEOS",
    "reference_matching": "by_basis"
  },
  "output": {
    "directory": "outputs/module_A_n2_isotherm",
    "run_id": "mof5_n2",
    "overwrite": false,
    "save_logs": true,
    "save_dumps": false,
    "dump_every_steps": 100000,
    "save_plots": true,
    "save_csv": true
  }
}
