  "simulation": {
    "engine": "MLIP_MC",
    "method": "GCMC",
    "forcefield": {
      "framework": "UFF",
      "adsorbate": "auto",
      "cross_interactions": "auto"
    },
    "framework": "rigid",
    "cell_representation": "source",
    "minimum_image_policy": "error",
    "cutoff_A": 6.0,
    "unit_cells": [
      1,
      1,
      1
    ],
    "seeds": [
      12345
    ]
