{
  "material": {
    "name": "ZIF-8",
    "cif_source": "auto",
    "charge_scheme": "DDEC",
    "source": "crafted"
  },
  "adsorbates": {
    "components": [
      "CO2"
    ],
    "mixture": null
  },
  "conditions": {
    "temperature_K": 298.15,
    "pressures_bar": [
      1.0
    ]
  },
  "benchmark": {
    "task": "potential_benchmark",
    "metrics": [
      "isotherm",
      "uptake",
      "runtime_per_step"
