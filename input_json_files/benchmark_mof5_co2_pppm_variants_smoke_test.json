      },
      {
        "name": "UFF-pppm_1e-5",
        "forcefield": "UFF",
        "pppm_accuracy": 1e-5
      },
      {
        "name": "UFF-pppm_1e-6",
        "forcefield": "UFF",
        "pppm_accuracy": 1e-6
      }
    ], 
    "metrics": [
      "isotherm",
      "error_to_reference",
      "runtime",
      "validity_range"
    ],
    "reference": {
      "source": "auto",
      "preferred_sources": [
        "crafted",
        "nist_isodb"
      ],
      "temperature_tolerance_K": 2.0,
